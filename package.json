{
  "name": "@dsh-external/dsh-clipboard-history",
  "version": "0.1.0",
  "description": "Monitor the system clipboard and keep a searchable persisted history with a Web panel and agent tools for DeepSeek Harness (DSH).",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "clipboard",
    "history"
  ],
  "license": "MIT",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qqyumidi/dsh-clipboard-history.git"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/qqyumidi/dsh-clipboard-history"
}
